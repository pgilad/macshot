<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Screenshots can hold secrets. The sandbox limits what a bug in macshot can reach.
	     There is no network entitlement, so the sandbox blocks every outgoing connection. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Save panels, Open Image… and the chosen save folder. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keeps access to the chosen save folder across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- The Accessibility API, which scroll capture (auto-scroll) and element snapping use
	     after the user grants the Accessibility permission. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.axserver</string>
	</array>
	<key>com.apple.security.temporary-exception.mach-lookup.local-name</key>
	<array>
		<string>com.apple.axserver</string>
	</array>
</dict>
</plist>
